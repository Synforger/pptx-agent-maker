#!/usr/bin/env bash
# Stop a push that carries text or values from private decks (= .tooling/local-ci/private-corpus-check.py).
# The global dispatcher runs this before its own checks, with the same ref lines on stdin.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
commits=()
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    case "${local_sha}" in *[!0]*) ;; *) continue ;; esac   # a branch being deleted sends nothing
    while read -r sha; do
        [ -n "${sha}" ] && commits+=("${sha}")
    done < <(git rev-list "${local_sha}" --not --remotes)
done

[ "${#commits[@]}" -gt 0 ] || exit 0
exec python3 "${root}/.tooling/local-ci/private-corpus-check.py" --commits "${commits[@]}"
