# --- A deck project never lives in this repo (see README) ---
# The toolkit is here; manifests, assets, page scripts and built decks live in a
# workspace outside it. These patterns make an accidental copy uncommittable.
/workspace/
/work/
/projects/
/decks/
/output/
*.pptx
*.potx
*.ppt
*.pdf
*.png
*.jpg
*.jpeg
# ...except the few-byte images the tests draw on. Without them a fresh clone
# cannot run its own test suite.
!tests/data/*.png
# ...and the two files the project template ships with. A template whose example
# cannot be baked is not a template: `init` would land on "no specimen" instead.
!src/pptx_agent_maker/templates/project/specimen.pptx
!src/pptx_agent_maker/templates/project/assets/**/*.png

# --- build artefacts ---
__pycache__/
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.pytest_cache/

# --- dev tools ---
.venv/
venv/
.envrc
.python-version
.idea/
.DS_Store
